# Copy this file to .env and paste in the real values:
#
#     cp .env.example .env
#
# .env is gitignored and stays on your own laptop. Never commit it, never paste
# a key into chat. Share keys with the team via password manager or AirDrop.
#
# Check your setup at any time with:  make doctor

# --- required -------------------------------------------------------------

# Sarvam: Saaras STT, Sarvam-30B, Bulbul TTS. Used by gaps / narrate / speak.
SARVAM_API_KEY=

# OpenAI: vision scene understanding only. Used by scenes.
OPENAI_API_KEY=

# --- optional -------------------------------------------------------------

# Vision model for the scenes stage.
OPENAI_MODEL=gpt-5.6

# Optional scene-output limits. The same values can be changed per run with
# `python3 -m drishti.scenes ... --set name=value`; the resolved values are
# recorded in that job's scenes-param.json.
# DRISHTI_SCENES_TONE_MAX_WORDS=4
# DRISHTI_SCENES_MAX_ENTITY_DETAILS=20
# DRISHTI_SCENES_ENTITY_DESCRIPTION_MAX_WORDS=18

# Script-as-context. Supplying a script IS the switch: give the pipeline one
# (--script, or the UI's script card) and the scenes stage receives it as
# fenced background context. Give none and nothing changes anywhere. Set this
# to 0 to keep a supplied script out of the vision prompt — it still feeds the
# cast stage. Equivalent to --no-script-context.
# DRISHTI_SCRIPT_CONTEXT=0
# DRISHTI_SCENES_SCRIPT_MAX_CHARS=6000

# Python.org installs on macOS may need Homebrew's CA bundle. Uncomment only
# if an API call fails with CERTIFICATE_VERIFY_FAILED.
# SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem

# dev  = runs/dev,  permissive, warnings only        (default)
# demo = runs/demo, strict, refuses to write a bad output
DRISHTI_PROFILE=dev

# Set to 1 to bypass the response cache and force real API calls.
# DRISHTI_NO_CACHE=1
